# mario-skills 共享环境变量 —— 模板
#
# 这份文件是 ~/.mario-skills/.env 的样子。所有 mario-skills 共用同一个文件，
# 同一个键只写一次，每个 skill 都能看到。自己不认识的键会被忽略——这就是
# 一个文件能同时服务所有 skill 的原因。
#
# 由 `bash scripts/wfc_setup.sh --init` 生成和合并（人跑）。不要手改这个
# 模板再拷过去——向导会保留你文件里的注释和别的 skill 的键。
#
# 解析顺序，高优先级在前：
#   1. 进程环境          VAULT_DIR=/x bash wfc_capture.sh all
#   2. <cwd>/.mario-skills/.env
#   3. ~/.mario-skills/.env
#   4. 内置默认值
#
# 值是「解析」出来的，不是 `source` 出来的——.env 里可能有 `$(...)`，source
# 等于把任意代码执行权交给一个配置文件。


# ---------------------------------------------------------------------------
# wechat-favorites-capture
# ---------------------------------------------------------------------------

# Vault 根目录。跟其它 skill 共享（diary-writer 也用它）。
# 已经在文件里定义过时，向导不会覆盖它。
VAULT_DIR=/Users/you/Documents/Obsidian

# 采集内容保存目录（相对 vault）。默认 raw —— 原始素材区，只写不改。
# 也可以写绝对路径。
WX_FAV_OUT_SUBDIR=raw

# 该目录下的数据集子目录。留空 = 直接存在 WX_FAV_OUT_SUBDIR 里，不多一层。
WX_FAV_SET_SUBDIR=WeChat-Favorites

# 默认抓取分层。
#   T1   = 2024 年起的 AI 时代内容（默认）
#   T2   = 2024 年前但受众关心的（管理 / 金融 / 理财 / 生活）
#   T3   = 旧技术细节
#   all  = 不分层，全抓
WX_FAV_TIER=T1

# 默认最多抓几篇。0 = 不限。
WX_FAV_LIMIT=0

# 每块几篇。浏览器会话连抓十几篇后会整体僵死，≤6 最稳。
WX_FAV_CHUNK=6

# 每篇间隔秒数。微信风控，15~20 比较安全。
WX_FAV_DELAY=20

# 写进 frontmatter 的 tag。
WX_FAV_TAG=wechat-favorites

# opencli 浏览器会话名。preflight 自检和正文抓取用同一个名字，
# 改了这里两边一起改。
WX_FAV_SESSION=wxscrape

# 状态目录：解密工作副本、密钥日志、抓取日志、venv 都在这儿。
WX_FAV_STATE_DIR=/Users/you/.local/share/wechat-favorites-capture

# 微信收藏库路径。留空 = 自动探测
# ~/Library/Containers/com.tencent.xinWeChat/.../db_storage/favorite/favorite.db
WX_FAV_DB=

# 覆盖依赖 skill 的位置。留空 = 自动探测 ~/.claude/skills/ 下的同名目录。
WX_FAV_VIZ_SKILL=
WX_FAV_SCRAPER_SKILL=

# 浏览器桥。跟 dedao-course-sync 共享同一个键。
OPENCLI_BIN=opencli
