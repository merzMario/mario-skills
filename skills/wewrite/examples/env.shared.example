# mario-skills shared environment
#
# This file is read by EVERY skill in mario-skills. Write a key once here and
# all of them see it. Never commit it — the repo .gitignore covers
# .mario-skills/.
#
# Two locations, project beats user:
#   <project>/.mario-skills/.env    project-level, checked first
#   ~/.mario-skills/.env           user-level, applies everywhere
#
# Resolution order (highest first):
#   1. process environment       VAULT_DIR=/x bash script.sh
#   2. <project>/.mario-skills/.env
#   3. ~/.mario-skills/.env
#   4. built-in defaults
#
# Syntax: KEY=VALUE, one per line. Blank lines and # comments ignored.
# An optional `export ` prefix is accepted. Values may be wrapped in matching
# quotes to preserve leading/trailing spaces. Only the first `=` splits, so
# values may contain `=`. Later definitions of the same key win.
#
# Values are PARSED, never executed as shell. `$(...)`, backticks, and `;` are
# stored as literal text — this file cannot run code.

# --- wewrite ---------------------------------------------------------------
# 微信公众号内容管道。产出全部落进 Obsidian Vault 的 output/WeWrite/。
#
#   bash scripts/wewrite.sh --detect      # 看本机环境
#   bash scripts/wewrite.sh --init        # 写 ~/.mario-skills/.env
#   bash scripts/wewrite.sh --config-info # 看每个值的来源

# --- diary-writer -------------------------------------------------------
# Append-only journal writer.

# Absolute path to the markdown vault root.
VAULT_DIR=/Users/you/Documents/Obsidian

# Journal directory, relative to VAULT_DIR.
JOURNALS_SUBDIR=journals

# Where hashes, logs, and pre-write backups live. Machine-local, not in the vault.
STATE_DIR=/Users/you/.local/share/diary-obsidian

# frontmatter tags, comma-separated. Leave empty to write no tags.
TEMPLATE_TAGS=日记,复盘


# --- book-enquire-reader ------------------------------------------------
# Long-book reader. Ingest + retrieval scope for enquire-mcp.

# Where book folders live, relative to VAULT_DIR.
BOOKS_SUBDIR=raw/books

# THE RETRIEVAL SCOPE. Every obsidian_search / obsidian_hyde_search call must
# pass folder="<BOOKS_SUBDIR>/<category>/<slug>/<BOOK_SOURCE_SUBDIR>", so the
# digests written into <BOOK_NOTES_SUBDIR> never enter the candidate pool.
BOOK_SOURCE_SUBDIR=_source

# Where chapter digests are written. Deliberately OUTSIDE the retrieval scope.
BOOK_NOTES_SUBDIR=notes

# Use obsidian_hyde_search for under-specified queries (v3.1.0+).
BOOK_HYDE=true

# Summarize cross-chapter themes via obsidian_get_communities (v3.4.0+).
# That tool has no folder argument — the agent filters communities[].members
# by path prefix itself.
BOOK_GRAPH=true

# Enable OCR for scanned PDFs. Costs ~1-2s per page on CPU and additionally
# requires `enquire-mcp install-ocr-lang <code>` on the serving machine.
BOOK_OCR=false

# Ceiling on obsidian_search `limit` — the hard cap on context tokens per query.
BOOK_MAX_CHUNKS=5

# The enquire-mcp binary. Only used by --reindex and `status`.
BOOK_ENQUIRE_BIN=enquire-mcp

# Manifest and pre-import backups. Machine-local. Deliberately NOT STATE_DIR —
# that key belongs to diary-writer, and sharing one would collide the two
# skills' hash and backup directories.
BOOK_STATE_DIR=/Users/you/.local/share/book-enquire-reader


# --- dedao-course-sync --------------------------------------------------
# Incremental sync of the 得到 精选 / 得到头条 columns.
#
#   bash scripts/dedao_sync.sh --detect
#   bash scripts/dedao_sync.sh --init

# Output directory, relative to VAULT_DIR.
DEDAO_OUT_SUBDIR=raw/Courses-GetIt

# opencli browser session name. Two concurrent runs sharing one session swap
# each other's tab, and the body probe reads the previous article.
DEDAO_SESSION=dedao-sync

# Default number of NEW articles per run. --count overrides it.
DEDAO_COUNT=20

# Failure log lives here, not in the vault and not in the skill directory.
DEDAO_STATE_DIR=/Users/you/.local/share/dedao-course-sync

# The browser bridge. Fetching requires it AND a Chrome already logged into
# 得到 with the OpenCLI extension connected — `opencli doctor` must be green.
OPENCLI_BIN=opencli


# --- dankoe-letters-fetch ----------------------------------------------
# Incremental fetch of Dan Koe's newsletter into raw/DanKoe/原文/.
#
#   bash scripts/dankoe_fetch.sh --detect
#   bash scripts/dankoe_fetch.sh --init

# Output root, relative to VAULT_DIR. Articles land in <DANKOE_OUT_SUBDIR>/原文/,
# alongside the 翻译/ directory maintained by the separate translation flow.
#
# NOTE: this used to read 00-Raw/DanKoe/. After the 2026-10-12 vault
# reorganisation the real output moved to raw/ and the mismatch broke dedup
# silently — every run re-fetched all 95 articles. Keep the two in sync.
DANKOE_OUT_SUBDIR=raw/DanKoe

# opencli browser session name. Do not share one across processes — they will
# swap each other's tab mid-extract.
DANKOE_SESSION=dankoe-letters

# Default number of NEW articles per run. --count overrides it. Dan Koe
# publishes weekly, so 10 covers several months.
DANKOE_COUNT=10

# Failure log lives here, not in the vault and not in the skill directory.
DANKOE_STATE_DIR=/Users/you/.local/share/dankoe-letters-fetch

# The browser bridge. Substack needs no login, but the body renders client-side,
# so `fetch` needs this plus a connected OpenCLI extension. `list` only uses
# curl and works without it.
OPENCLI_BIN=opencli


# --- wewrite ---------------------------------------------------------------
# 微信公众号内容管道：选题 → 任务书与证据 → 初稿 → 编辑成稿，配图、排版、
# 推草稿箱按需追加。
#
#   bash scripts/wewrite.sh --detect      # 看本机环境
#   bash scripts/wewrite.sh --init        # 写 ~/.mario-skills/.env
#   bash scripts/wewrite.sh --config-info # 看每个值的来源

# 产出目录，相对 VAULT_DIR。每次写作任务一个 runs/<run_id>/ 子目录，
# 成稿、配图、预览、审稿报告都在里面。
#
# 默认 output/WeWrite —— 符合本 vault 对 output/ 的定义（CLAUDE.md：
# 「输出内容的保存路径」）。raw/ 是不可变的原始素材区，不往那里写。
# 想换成 02-Output/02-Platforms/微信公众号，只改这一行。
WEWRITE_OUT_SUBDIR=output/WeWrite

# 产出目录的**绝对路径**，配了就压过上面两个键。一般不用设 —— 设它的场景是
# 你想把产出放到 vault 之外（比如一个单独的同步盘）。
# WEWRITE_OUT_DIR=/Users/you/Documents/WeWrite

# 状态根：凭证 config.yaml、style.yaml、history.yaml、playbook.md、
# corpus/、exemplars/、themes/、personas/。
#
# ⚠️ 这里绝对不能指向 vault。里面会存公众号 appsecret，而这个 vault 既是
# git 仓库又被 iCloud 同步。
WEWRITE_HOME=/Users/you/.wewrite

# 微信公众号 API。推草稿箱和拉数据必需；不配就只能生成本地预览。
WECHAT_APPID=
WECHAT_SECRET=

# 默认署名，可选。
WECHAT_AUTHOR=

# 图片生成。留空则配图步骤自动降级为「只出提示词」。
# 支持 doubao / dashscope / jimeng / minimax / openai / azure_openai / gemini /
# openrouter / replicate / sub2api。配一个就能用。
WEWRITE_IMAGE_PROVIDER=
WEWRITE_IMAGE_API_KEY=
# 可选，各 provider 有自己的默认值
WEWRITE_IMAGE_MODEL=

# 排版主题。`wewrite gallery` 可以看全部可选主题。
# 内置：minimal / minimal-gold / professional-clean / sspai / ink / midnight /
#       warm-editorial / github / tech-modern / bytedance / focus-red /
#       bold-green / bold-navy / elegant-rose / bauhaus / lobster-notes / impeccable
WEWRITE_THEME=professional-clean

# 写作模型，可选。不配就由 agent 自己写正文。
# 走 OpenAI 兼容协议，deepseek 默认最省事。
WEWRITE_WRITER_API_KEY=
WEWRITE_WRITER_PROVIDER=deepseek
WEWRITE_WRITER_BASE_URL=https://api.deepseek.com
WEWRITE_WRITER_MODEL=deepseek-chat


# --- other skills -------------------------------------------------------
# Keys a sibling skill needs go here too, in their own block. Every skill
# ignores keys it does not recognize, and so does every other skill.
#
# OPENAI_API_KEY=sk-...
# WEIXIN_APP_ID=wx...
